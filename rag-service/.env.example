# OpenAI — required for embeddings, generation, and Ragas LLM-as-judge
OPENAI_API_KEY=sk-...

# Milvus (existing Docker Compose service)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=fashion_rag

# PostgreSQL (reuses existing fashion-recommend DB)
POSTGRES_URL=postgresql://gorse:gorse_pass@localhost:5432/gorse

# Redis (TTL cache for frequent RAG queries)
REDIS_URL=redis://localhost:6379

# Kafka (async ingestion write path — not needed for query path)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGEST_TOPIC=rag-ingest

# CRAG corrective loop tuning
CRAG_HIGH_THRESHOLD=0.75
CRAG_LOW_THRESHOLD=0.45
CRAG_MAX_RETRIES=2
CRAG_TIME_BUDGET_S=3.5

# Phase 2 only — leave unset in Phase 1
# PINECONE_API_KEY=...
# PINECONE_INDEX_NAME=fashion-rag
